# --- Supabase (server-side; service role bypasses RLS — keep secret) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- eBay Browse API (OAuth client-credentials / "Application access token") ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# --- Web deal scout (Google Shopping index via serper.dev; free tier) ---
SERPER_API_KEY=

# --- AI listing judge (Vercel AI Gateway; auto-authed on Vercel deployments) ---
SNAG_JUDGE_MODEL=anthropic/claude-haiku-4.5

# --- Watcher ---
# Shared secret required to trigger the watch endpoint (Vercel Cron / pg_cron).
CRON_SECRET=
# How far below the reference price counts as a "good deal" (0.10 = 10%).
SNAG_GOOD_DEAL_PCT=0.10
